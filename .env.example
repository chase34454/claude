# Copy to .env and export (or use your process manager). Never commit .env.
ANTHROPIC_API_KEY=
FLEET_MODEL=claude-opus-5-5
# FLEET_REVIEW_MODEL=            # defaults to FLEET_MODEL
FLEET_DB=fleet.db
FLEET_WORKSPACE=workspace
FLEET_CONCURRENCY=4
FLEET_DEFAULT_BUDGET_USD=1.00
FLEET_APPROVAL_TIMEOUT_S=900
FLEET_MAX_TURNS=30

# Alerts (leave blank to disable; alerts then go to the log only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FLEET_ALERT_TO_NUMBER=

# Browser
# FLEET_BROWSER_ALLOW_PRIVATE=0   # 1 allows localhost/private-network URLs
# FLEET_BROWSER_NO_SANDBOX=0      # 1 only inside a container you trust
# FLEET_CHROMIUM_PATH=
# Optional: claude CLI for orchestrating Claude Code sessions
# FLEET_CLAUDE_BIN=claude
